# FundiPro Environment Configuration

# App
APP_ENV=development
APP_URL=https://fundipro.co.ke
APP_TIMEZONE=Africa/Nairobi

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=fundipro_kenya
DB_USERNAME=root
DB_PASSWORD=

# JWT
JWT_SECRET=change-this-in-production

# M-Pesa Daraja API
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://fundipro.co.ke/api/payments/callback

# Africa's Talking SMS
AT_API_KEY=your_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=FundiPro

# Subscription Pricing (KES)
PLAN_FREE_PRICE=0
PLAN_FREE_JOBS=3
PLAN_PRO_PRICE=500
PLAN_BUSINESS_PRICE=1200

# HMS Environment Configuration

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hms_kenya
DB_USERNAME=root
DB_PASSWORD=

# Application
APP_ENV=development
APP_URL=https://hms.co.ke
APP_TIMEZONE=Africa/Nairobi

# JWT Secret
JWT_SECRET=your-secret-key-here-change-in-production

# M-Pesa Configuration (Daraja API)
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://hms.co.ke/api/payments/callback

# SMS Configuration (Africa's Talking)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_api_key
AFRICASTALKING_SENDER_ID=HMS

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=info@hms.co.ke
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@hms.co.ke
MAIL_FROM_NAME="HMS Hospital"

# Emergency Numbers
EMERGENCY_PRIMARY=999
EMERGENCY_SECONDARY=112
HOSPITAL_EMERGENCY=+254700911911
